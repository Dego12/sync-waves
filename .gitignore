############################
# Entity Framework Core
############################

# EF Core creates snapshot files in Migrations
# KEEP migrations folder EXCEPT these:
*Migrations/*.Designer.cs
*Migrations/*ModelSnapshot.cs

# (Delete these two if you prefer to keep snapshots)
# but usually they are ignored.

############################
# Configuration / Secrets
############################

# User secrets (should NOT be committed)
appsettings.Development.json
appsettings.Local.json
appsettings.*.json

# Private env files
*.env
.env.*

